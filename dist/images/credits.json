    "habitat": "bleaching",
    "source": "https://commons.wikimedia.org/wiki/File:%22The_Great_Coral_Bleaching_of_2023%22_-_53088200178.jpg",
    "original": "https://upload.wikimedia.org/wikipedia/commons/3/36/%22The_Great_Coral_Bleaching_of_2023%22_-_53088200178.jpg",
    "width": 3000,
